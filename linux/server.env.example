# Copy to linux/server.env and fill in. Do not commit server.env.
# Used by linux/remote-bootstrap.ps1 (from Windows) to SSH into the PBX.

# Required
SSH_HOST=203.0.113.10
SSH_USER=root
# SSH_PORT=22

# Auth: set one of these
# SSH_KEY=C:\Users\You\.ssh\id_rsa
# SSH_PASSWORD=

# Expected OS family (AlmaLinux 9 / Rocky Linux 9)
EXPECT_OS=el9

# Public hostname agents will use in the browser (no trailing slash)
CRM_PUBLIC_URL=https://pbx.example.com

# Git source of this CRM (default: your GitHub push)
CRM_GIT_URL=https://github.com/Ahmar765/Goautodial.git
CRM_GIT_BRANCH=main

# Web root on the PBX after GOautodial CE install
WEB_ROOT=/var/www/html

# Optional: skip long Asterisk compile if stack already installed
# SKIP_STACK_INSTALL=0

# --- Telnyx SIP (default for Ahmar deploy) — IP address authentication ---
# In Telnyx Mission Control: allow this PBX public/WAN IP on the IP Auth connection.
SIP_CARRIER_ID=TELNYX
SIP_CARRIER_NAME=Telnyx
SIP_AUTHENTICATION=ip
SIP_REG_HOST=sip.telnyx.com
SIP_REG_PORT=5060
SIP_USERNAME=15123916660
SIP_PASSWORD=
SIP_OUTBOUND_CID=15123916660
SIP_DID=15123916660
SIP_SERVER_IP=
SIP_DIAL_PREFIX=9
SIP_CODECS=ulaw,alaw
SIP_DTMF=rfc2833
SIP_PROTOCOL=SIP

