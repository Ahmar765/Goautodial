# Docker Compose substitutions only; native PHP does not load .env automatically.
# Fill every required value. Use distinct generated secrets, not these comments.
APP_URL=https://crm.example.com
GO_API_URL=https://dialer.example.com/goAPIv2
GO_API_USER=
GO_API_PASSWORD=
SESSION_ENCRYPTION_KEY=
DB_USER=
DB_PASS=
DB_ROOT_PASSWORD=
DB_HOST_ASTERISK=10.20.0.20
DB_PORT_ASTERISK=3306
DB_NAME_ASTERISK=asterisk
DB_USER_ASTERISK=
DB_PASS_ASTERISK=
DB_HOST_KAMAILIO=10.20.0.20
DB_PORT_KAMAILIO=3306
DB_NAME_KAMAILIO=kamailio
DB_USERNAME_KAMAILIO=
DB_PASSWORD_KAMAILIO=
# For a trusted host reverse proxy, use its address as seen inside the container.
TRUSTED_PROXIES=
# Optional SMTP settings must match the backend's encryption settings.
SMTP_ENCRYPTION_SECRET=
SMTP_ENCRYPTION_IV_SECRET=
WHATSAPP_SEND_URL=
WHATSAPP_WEBHOOK_URL=
SIP_DOMAIN=sip.example.com
SIP_WS_HOST=sip.example.com
SIP_WS_PORT=8089
