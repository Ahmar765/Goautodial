# Copy to .env in the project root (same folder as agent.php) and adjust.
# Linux live PBX: use linux/02-deploy-crm.sh (writes production .env from astguiclient.conf).
# Apache/PHP must be able to read .env (file permissions 640, owner apache).

APP_ENV=local

# GOautodial goAPIv2 base URL — no trailing slash
# Local XAMPP: http://localhost/goAPIv2
# Linux production (server-side PHP): http://127.0.0.1/goAPIv2
GO_API_BASE_URL=http://localhost/goAPIv2

# CRM → goAPI service account (must match goAPIv2 config on the GOautodial server)
GO_API_USER=goAPI
GO_API_PASS=KToB93bzjGd1RS4mDqePJ6Uk.jgNRrK

# Database — XAMPP local defaults below; Linux CE defaults are typically:
#   DB_USER=goautodialu  DB_PASS=goautodialu1234  (see astguiclient.conf-sample)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=goautodial
DB_NAME_ASTERISK=asterisk

# Local XAMPP only. On Linux production MUST be false (live calling needs goAPI).
CRM_LOGIN_LOCAL_DB_FALLBACK=true

# Optional Kamailio DB (WebRTC / SIP)
# DB_HOST_KAMAILIO=127.0.0.1
# DB_NAME_KAMAILIO=kamailio
# DB_USERNAME_KAMAILIO=kamailiou
# DB_PASSWORD_KAMAILIO=kamailiou1234
