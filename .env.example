# Copy to .env in the project root (same folder as agent.php) and adjust.
# On Linux production: set APP_ENV=production and point GO_API_BASE_URL at your server.
# Apache/PHP must be able to read .env (file permissions).

APP_ENV=local

# GOautodial goAPIv2 base URL — no trailing slash
# Local XAMPP (after you install/symlink goAPIv2): http://localhost/goAPIv2
# Production: https://your-pbx.example.com/goAPIv2
GO_API_BASE_URL=http://localhost/goAPIv2

# CRM → goAPI service account (must match goAPIv2 config on the GOautodial server)
GO_API_USER=goAPI
GO_API_PASS=KToB93bzjGd1RS4mDqePJ6Uk.jgNRrK

# Database (CRM + vicidial_users for local agent login)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=goautodial
DB_NAME_ASTERISK=asterisk

# Local dev only: log in using asterisk.vicidial_users when goAPI is down (seed via php/seed_login_users.php)
# Set false on production
CRM_LOGIN_LOCAL_DB_FALLBACK=true

# Optional Kamailio DB (WebRTC / SIP) — leave defaults if unused
# DB_HOST_KAMAILIO=127.0.0.1
# DB_NAME_KAMAILIO=kamailio
